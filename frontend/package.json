{
    "name": "frontend",
    "version": "1.0.0",
    "private": true,
    "description": "Frontend del flujo de aprobaciones con firma digital (micro-frontends con Webpack Module Federation)",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/tests/**/*.{ts,tsx}\"",
        "start:shell": "npm run start --workspace=shell",
        "start:requester-app": "npm run start --workspace=requester-app",
        "start:approver-app": "npm run start --workspace=approver-app",
        "dev": "concurrently -n shell,requester-app,approver-app -c blue,green,yellow \"npm:start:shell\" \"npm:start:requester-app\" \"npm:start:approver-app\"",
        "build": "npm run build --workspaces --if-present",
        "deploy:site": "node scripts/deploy-site.js"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@serverless/typescript": "4.30.0",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.0",
        "@types/jest": "30.0.0",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "concurrently": "10.0.5",
        "css-loader": "7.1.4",
        "dotenv": "17.4.2",
        "eslint": "10.8.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.6",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.11.0",
        "html-webpack-plugin": "5.6.8",
        "jest": "30.4.2",
        "jest-environment-jsdom": "30.4.1",
        "prettier": "3.9.6",
        "serverless": "4.41.0",
        "style-loader": "4.0.0",
        "ts-jest": "29.4.12",
        "ts-loader": "9.6.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0",
        "webpack": "5.109.2",
        "webpack-cli": "7.2.2",
        "webpack-dev-server": "6.0.0"
    }
}
