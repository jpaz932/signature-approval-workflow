{
    "name": "frontend",
    "version": "1.0.0",
    "private": true,
    "description": "Frontend del flujo de aprobaciones con firma digital (micro-frontends con Webpack Module Federation)",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "typecheck": "npm run typecheck --workspaces --if-present",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/tests/**/*.{ts,tsx}\""
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.0",
        "@types/jest": "30.0.0",
        "@types/node": "26.2.0",
        "eslint": "10.8.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.6",
        "globals": "17.11.0",
        "jest": "30.4.2",
        "jest-environment-jsdom": "30.4.1",
        "prettier": "3.9.6",
        "ts-jest": "29.4.12",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0"
    }
}
